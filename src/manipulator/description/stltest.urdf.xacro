<?xml version="1.0"?>
<robot name="manipulator">

  <!-- ========================================================= -->
  <!-- 4-DOF Manipulator URDF with STL Meshes                    -->
  <!--                                                          -->
  <!-- Mesh path example:                                       -->
  <!-- package://manipulator/model/*.stl                       -->
  <!--                                                          -->
  <!-- Current STL directory based on your project tree:         -->
  <!-- manipulator/model/                                       -->
  <!-- capstone_manipulator_description with your package name.  -->
  <!-- ========================================================= -->

  <!-- Optional materials for RViz -->
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>

  <material name="dark_grey">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.6 0.1 0.1 1.0"/>
  </material>

  <!-- =========================
      link1: base block
      ========================= -->
  <link name="link1">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator/model/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator/model/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <mass value="1.0"/>
      <inertia ixx="0.0004166667" ixy="0" ixz="0" iyy="0.0004166667" iyz="0" izz="0.0004166667"/>
    </inertial>
  </link>

  <!-- joint1: base yaw, Z axis -->
  <joint name="joint1" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin rpy="0 0 0" xyz="0 0 0.05"/>
    <axis xyz="0 0 1"/>
    <limit effort="0.1" lower="-3.14159265359" upper="3.14159265359" velocity="4.8"/>
  </joint>

  <!-- =========================
      link2: vertical riser
      ========================= -->
  <link name="link2">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.05"/>
      <geometry>
        <mesh filename="package://manipulator/model/link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator/model/link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.06"/>
      <mass value="0.8"/>
      <inertia ixx="0.0019866667" ixy="0" ixz="0" iyy="0.0019866667" iyz="0" izz="0.0003333333"/>
    </inertial>
  </link>

  <!-- joint2: shoulder pitch, Y axis -->
  <joint name="joint2" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin rpy="0 0 0" xyz="0 0 0.12"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.1" lower="-3.14159265359" upper="0.785398" velocity="4.8"/>
  </joint>

  <!-- =========================
      link3: upper arm
      ========================= -->
  <link name="link3">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.17"/>
      <geometry>
        <mesh filename="package://manipulator/model/link_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator/model/link_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.15 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.0002500000" ixy="0" ixz="0" iyy="0.0046250000" iyz="0" izz="0.0046250000"/>
    </inertial>
  </link>

  <!-- joint3: elbow pitch, Y axis -->
  <joint name="joint3" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin rpy="0 0 0" xyz="0.30 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.1" lower="0" upper="2.7" velocity="4.8"/>
  </joint>

  <!-- =========================
      link4: forearm
      ========================= -->
  <link name="link4">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator/model/link_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator/model/link_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.15 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.0002083333" ixy="0" ixz="0" iyy="0.0038541667" iyz="0" izz="0.0038541667"/>
    </inertial>
  </link>

  <!-- joint4: wrist pitch, Y axis -->
  <joint name="joint4" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin rpy="0 0 0" xyz="0.30 0 0"/>
    <axis xyz="0 1 0"/>
    <limit effort="0.1" lower="-1.5" upper="1.5" velocity="4.8"/>
  </joint>

  <!-- =========================
      link5: wrist / end link
      ========================= -->
  <link name="link5">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator/model/link_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://manipulator/model/link_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.05 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0000300000" ixy="0" ixz="0" iyy="0.0001766667" iyz="0" izz="0.0001766667"/>
    </inertial>
  </link>
</robot>
